# Example environment variables for local/demo use.
# This is not a production configuration.
# World state is still in-process. Workspace files persist on disk.
# The audit JSONL is HMAC-signed when MO_AUDIT_HMAC_KEY or a real SECRET_KEY is set.
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change-this-in-production-use-a-random-string

# Server configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4

# Simulation configuration
TICK_DURATION_MS=1000
AUTO_ASSIGN_TASKS=true

# CORS configuration (comma-separated origins)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/miniature-office/app.log

MO_WORKSPACE=./user_workspace
MO_DATA_DIR=./data
# Optional HMAC key for the audit chain (falls back to SECRET_KEY when set to a real value)
# MO_AUDIT_HMAC_KEY=
# Optional token for /api/ide/* (required when FLASK_ENV=production)
# MO_IDE_TOKEN=
