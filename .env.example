# Example environment variables for local/demo use.
# This is not a production configuration.
# World state is still in-process. Workspace files persist on disk.
# src/server/app.py calls load_dotenv(); only the names below are getenv()'d.

FLASK_ENV=development
SECRET_KEY=change-this-in-production-use-a-random-string

# Read by the Flask app
CORS_ORIGINS=*
MO_WORKSPACE=./user_workspace
MO_DATA_DIR=./data
# Optional HMAC key for the audit chain (falls back to SECRET_KEY when set to a real value)
# MO_AUDIT_HMAC_KEY=
# Optional token for /api/ide/* (required when FLASK_ENV=production)
# MO_IDE_TOKEN=

# Not read (do not set these expecting an effect):
# HOST / PORT — run.py hardcodes 0.0.0.0:5000; Docker gunicorn CMD hardcodes bind
# WORKERS — Docker gunicorn CMD hardcodes --workers 4
# TICK_DURATION_MS — init_simulation() hardcodes tick_duration_ms=1000
# AUTO_ASSIGN_TASKS — init_simulation() hardcodes auto_assign_tasks=True; SimulationEngine never reads the flag
# AUTO_RESOLVE_MEETINGS — dataclass default True; never read. Tick sets in_meeting and returns
# LOG_FILE / LOG_LEVEL — gunicorn logs to stdout/stderr
# FLASK_DEBUG — gunicorn does not honor it; run.py passes debug=False
